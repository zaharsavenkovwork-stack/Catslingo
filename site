<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Catslingo</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;800;900&display=swap" rel="stylesheet">
<style>
:root{--bg:#fff7ee;--card:#fff;--text:#2d2a32;--muted:#8a8392;--acc:#ff8a3d;--acc2:#e9702a;--good:#3fbf72;--goodbg:#e3f7ea;--bad:#ef5b5b;--badbg:#fde8e8;--line:#f0e3d4;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1d1a22;--card:#2a2630;--text:#f4eee8;--muted:#a49cac;--line:#3a3442;--goodbg:#1f3a2a;--badbg:#412426;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#1d1a22;--card:#2a2630;--text:#f4eee8;--muted:#a49cac;--line:#3a3442;--goodbg:#1f3a2a;--badbg:#412426;color-scheme:dark}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;height:100%}
body{background:var(--bg);color:var(--text);font-family:'Nunito',system-ui,-apple-system,'Segoe UI',sans-serif;font-weight:700}
#app{max-width:480px;margin:0 auto;min-height:100%;display:flex;flex-direction:column;padding:16px}
.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
.logo{font-weight:900;font-size:20px;letter-spacing:.2px}
.pills{display:flex;gap:8px}
.pill{background:var(--card);border:2px solid var(--line);border-radius:999px;padding:6px 12px;font-weight:900;font-size:15px}
.hero{display:flex;align-items:center;gap:12px;background:var(--card);border:2px solid var(--line);border-radius:24px;padding:14px;margin-bottom:18px}
.hero svg{width:96px;height:96px;flex:none}
.bubble{position:relative;background:var(--bg);border-radius:16px;padding:12px 14px;font-size:15px;line-height:1.35}
h2{font-size:16px;margin:4px 4px 10px;color:var(--muted);text-transform:uppercase;letter-spacing:.8px;font-weight:900}
.path{display:flex;flex-direction:column;gap:12px;padding-bottom:20px}
.node{display:flex;align-items:center;gap:14px;background:var(--card);border:2px solid var(--line);border-bottom-width:5px;border-radius:20px;padding:14px;cursor:pointer;text-align:left;font:inherit;color:inherit;width:100%}
.node:active{transform:translateY(2px);border-bottom-width:3px}
.node .ic{width:52px;height:52px;border-radius:16px;background:var(--bg);display:grid;place-items:center;font-size:26px;flex:none}
.node b{display:block;font-size:17px;font-weight:900}
.node small{color:var(--muted);font-size:13px}
.node.cur{border-color:var(--acc)}
.node.cur .ic{background:var(--acc)}
.node.done .ic{background:var(--goodbg)}
.node.lock{opacity:.5;cursor:default}
.tag{margin-left:auto;font-size:20px}
.lh{display:flex;align-items:center;gap:12px;margin-bottom:18px}
.x{background:none;border:0;color:var(--muted);font-size:26px;cursor:pointer;padding:0 4px;font-family:inherit}
.bar{flex:1;height:14px;background:var(--line);border-radius:99px;overflow:hidden}
.bar i{display:block;height:100%;width:0;background:var(--acc);border-radius:99px;transition:width .4s}
.q{flex:1;display:flex;flex-direction:column}
.q h3{font-size:22px;margin:0 0 6px;font-weight:900}
.word{font-size:34px;font-weight:900;text-align:center;margin:18px 0 22px}
.opts{display:grid;gap:10px}
.opt{background:var(--card);border:2px solid var(--line);border-bottom-width:5px;border-radius:16px;padding:16px;font:inherit;font-size:18px;font-weight:800;color:inherit;cursor:pointer;text-align:center}
.opt:active{transform:translateY(2px)}
.opt.ok{border-color:var(--good);background:var(--goodbg)}
.opt.no{border-color:var(--bad);background:var(--badbg)}
.ans,.bank{display:flex;flex-wrap:wrap;gap:8px;min-height:58px;padding:8px 0}
.ans{border-top:2px solid var(--line);border-bottom:2px solid var(--line);margin:14px 0;min-height:70px;align-content:flex-start}
.chip{background:var(--card);border:2px solid var(--line);border-bottom-width:4px;border-radius:12px;padding:10px 14px;font:inherit;font-size:17px;font-weight:800;color:inherit;cursor:pointer}
.btn{width:100%;border:0;border-radius:16px;padding:16px;font:inherit;font-size:17px;font-weight:900;letter-spacing:.5px;text-transform:uppercase;color:#fff;background:var(--acc);box-shadow:0 5px 0 var(--acc2);cursor:pointer;margin-top:auto}
.btn:active{transform:translateY(3px);box-shadow:0 2px 0 var(--acc2)}
.btn:disabled{background:var(--line);box-shadow:0 5px 0 var(--line);color:var(--muted);cursor:default}
.fb{margin:14px -16px -16px;padding:14px 16px 20px;display:flex;flex-direction:column;gap:12px}
.fb.ok{background:var(--goodbg)}.fb.no{background:var(--badbg)}
.fbr{display:flex;align-items:center;gap:10px}
.fbr svg{width:64px;height:64px;flex:none}
.fbr p{margin:0;font-size:16px;line-height:1.35}
.fb.ok .btn{background:var(--good);box-shadow:0 5px 0 #2f9a5a}
.fb.no .btn{background:var(--bad);box-shadow:0 5px 0 #c94646}
.res{text-align:center;display:flex;flex-direction:column;flex:1;align-items:center}
.res svg{width:170px;height:170px;margin-top:20px}
.res h1{font-size:28px;margin:10px 0 4px;font-weight:900}
.stats{display:flex;gap:12px;margin:18px 0 24px;width:100%}
.stat{flex:1;background:var(--card);border:2px solid var(--line);border-radius:18px;padding:14px}
.stat b{display:block;font-size:26px;font-weight:900}
.stat small{color:var(--muted);font-size:13px}
.card{background:var(--card);border:2px solid var(--line);border-radius:24px;padding:22px;text-align:center;margin:10px 0 18px}
.cat{object-fit:contain;flex:none;display:block}
.hero .cat{width:96px;height:96px}.fbr .cat{width:84px;height:84px}.res .cat{width:170px;height:170px;margin-top:20px}
.hero3{display:flex;flex-direction:column;align-items:center;gap:10px;background:var(--card);border:2px solid var(--line);border-radius:24px;padding:14px 14px 0;margin-bottom:14px;overflow:hidden}
.bubble3{background:var(--bg);border-radius:18px;padding:10px 16px;font-size:15px;line-height:1.35;align-self:stretch;text-align:center}
.bubble3 b{font-size:22px;font-weight:900;margin-right:6px}
.trio{display:flex;align-items:flex-end;justify-content:center;gap:8px;flex:none}
.trio .cat-r{height:122px;width:auto}.trio .cat-p{height:108px;width:auto}.trio .cat-m{height:68px;width:auto}
.trio svg{height:100px;width:auto}
.cont{background:var(--card);border:2px solid var(--line);border-radius:22px;padding:14px;margin-bottom:14px}
.cont .row{display:flex;gap:12px;align-items:center;margin-bottom:12px}
.cont .ic{width:52px;height:52px;border-radius:16px;background:var(--bg);display:grid;place-items:center;font-size:26px;flex:none}
.cont small{display:block;color:var(--muted);font-size:13px}.cont b{display:block;font-size:18px;font-weight:900;line-height:1.2}
.ub{position:relative;overflow:hidden;border-radius:22px;padding:16px;color:#fff;display:flex;align-items:center;gap:14px;cursor:pointer;min-height:96px;margin-top:14px;list-style:none;box-shadow:0 4px 0 rgba(0,0,0,.12)}
.ub::-webkit-details-marker{display:none}
.ub img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.ub.hasimg::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.5),rgba(0,0,0,.05))}
.ub>*{position:relative;z-index:2}
.em2{font-size:40px;line-height:1;flex:none}
.uimg{width:84px;height:84px;flex:none;border-radius:20px;overflow:hidden;background:rgba(255,255,255,.22);display:grid;place-items:center;border:3px solid rgba(255,255,255,.85)}
.ubt{flex:1;min-width:0}.ubt b{font-size:18px;font-weight:900;display:block;line-height:1.2}.ubt small{display:block;font-size:13px;opacity:.95;margin-top:2px;line-height:1.3}
.ubp{height:6px;background:rgba(255,255,255,.35);border-radius:9px;margin-top:8px;overflow:hidden}.ubp i{display:block;height:100%;background:#fff;border-radius:9px}
.ubn{font-weight:900;font-size:15px;flex:none}
.nav{position:sticky;bottom:0;margin:auto -16px -16px;padding:8px 12px;background:var(--card);border-top:2px solid var(--line);display:flex;justify-content:space-around}
.nav button{background:none;border:0;font:inherit;font-weight:900;color:var(--muted);display:flex;flex-direction:column;align-items:center;gap:2px;cursor:pointer;font-size:12px;padding:6px 10px}
.nav button.on{color:var(--acc2)}.nav span{font-size:22px}
.meR{border-color:var(--acc)}
.mt{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}.mc{display:grid;gap:10px;align-content:start}.mb{padding:14px 8px;font-size:16px}.mb.sel{border-color:var(--acc);background:var(--bg)}
.em{font-size:72px;line-height:1.1}
.en{font-size:38px;font-weight:900;margin:6px 0}
.ru{font-size:22px;color:var(--acc2);margin:12px 0;font-weight:900}
.say{background:var(--bg);border:2px solid var(--line);border-radius:99px;padding:8px 16px;font:inherit;font-weight:800;color:inherit;cursor:pointer}
.exs{margin-top:10px;padding-top:12px;border-top:2px dashed var(--line);font-size:16px;line-height:1.5;color:var(--muted)}
.exs b{color:var(--text)}
.inp{width:100%;border:2px solid var(--line);border-bottom-width:5px;border-radius:16px;padding:16px;font:inherit;font-size:22px;font-weight:800;text-align:center;background:var(--card);color:var(--text);outline:none}
.inp:focus{border-color:var(--acc)}
.wr{display:flex;align-items:center;gap:12px;background:var(--card);border:2px solid var(--line);border-radius:16px;padding:10px 14px;margin-bottom:8px}
.wr b{font-size:17px;display:block}.wr small{color:var(--muted);font-size:14px}
.we{font-size:28px}.wr .x{margin-left:auto}
.pop{animation:pop .35s ease}
@keyframes pop{0%{transform:scale(.8);opacity:0}100%{transform:scale(1);opacity:1}}
</style>
</head>
