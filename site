<script>
function cat(k,mood){
 mood=mood||'happy';
 const m=['happy','sad','think','party'].includes(mood)?mood:'happy',key=k+'_'+m;
 const src=(window.CATIMG&&CATIMG[key])||'img/cats/'+key+'.webp';
 return `<img class="cat cat-${k}" src="${src}" alt="" onerror='this.outerHTML=catSvg("${k}","${mood}")'>`;
}
const CATS={
 r:{b:'#F28C38',hr:28,bw:30,bh:24},
 p:{b:'#34343c',hr:30,bw:46,bh:28},
 m:{b:'#34343c',hr:25,bw:20,bh:15}
};
function catSvg(k,mood){
 mood=mood||'happy';
 const c=CATS[k],hr=c.hr,hy=100-c.bh-hr*0.9,by=hy+hr*0.9,ey=hy-hr*0.05,ex=hr*0.4;
 const dk='#2a2230';
 let eyes;
 if(mood==='happy'){
  eyes=[-1,1].map(s=>`<path d="M${60+s*ex-5} ${ey+2} q5 -8 10 0" stroke="${dk}" stroke-width="2.8" fill="none" stroke-linecap="round"/>`).join('');
 }else{
  eyes=[-1,1].map(s=>`<circle cx="${60+s*ex}" cy="${ey}" r="3.6" fill="${dk}"/><circle cx="${60+s*ex+1}" cy="${ey-1.2}" r="1.1" fill="#fff"/>`).join('');
  if(mood==='sad') eyes+=[-1,1].map(s=>`<path d="M${60+s*ex-5} ${ey-7+(s<0?3:0)} L${60+s*ex+5} ${ey-7+(s<0?0:3)}" stroke="${dk}" stroke-width="2" stroke-linecap="round"/>`).join('');
 }
 const my=hy+hr*0.5;
 const mouth=mood==='sad'?`M54 ${my+3} q6 -5 12 0`:`M54 ${my} q3 4 6 0 q3 4 6 0`;
 const ears=`<path d="M${60-hr*0.95} ${hy-hr*0.1} L${60-hr*0.72} ${hy-hr*1.35} L${60-hr*0.15} ${hy-hr*0.85}Z" fill="${c.b}"/><path d="M${60+hr*0.95} ${hy-hr*0.1} L${60+hr*0.72} ${hy-hr*1.35} L${60+hr*0.15} ${hy-hr*0.85}Z" fill="${c.b}"/>`+
  `<path d="M${60-hr*0.78} ${hy-hr*0.35} L${60-hr*0.68} ${hy-hr*1.05} L${60-hr*0.33} ${hy-hr*0.75}Z" fill="#f7a5b0"/><path d="M${60+hr*0.78} ${hy-hr*0.35} L${60+hr*0.68} ${hy-hr*1.05} L${60+hr*0.33} ${hy-hr*0.75}Z" fill="#f7a5b0"/>`;
 const extra=k==='r'?`<path d="M${60-8} ${hy-hr*0.95} q3 6 0 10 M60 ${hy-hr*0.98} q0 7 0 11 M${60+8} ${hy-hr*0.95} q-3 6 0 10" stroke="#d9722a" stroke-width="2.4" fill="none" stroke-linecap="round"/>`:
  k==='p'?`<path d="M${60-hr} ${hy} q8 -4 14 -hr" fill="none"/>`:'';
 return `<svg viewBox="0 0 120 112" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
 <path d="M${60+c.bw*0.85} ${by+c.bh*0.4} q${c.bw*0.6} ${-c.bh*1.2} ${c.bw*0.1} ${-c.bh*1.5}" stroke="${c.b}" stroke-width="${k==='m'?5:7}" fill="none" stroke-linecap="round"/>
 <ellipse cx="60" cy="${by}" rx="${c.bw}" ry="${c.bh}" fill="${c.b}"/>
 <ellipse cx="60" cy="${by+c.bh*0.25}" rx="${c.bw*0.58}" ry="${c.bh*0.72}" fill="#fff"/>
 ${ears}
 <circle cx="60" cy="${hy}" r="${hr}" fill="${c.b}"/>
 ${extra}
 ${k!=='r'?`<ellipse cx="60" cy="${hy+hr*0.4}" rx="${hr*0.46}" ry="${hr*0.32}" fill="#fff"/>`:`<ellipse cx="60" cy="${hy+hr*0.4}" rx="${hr*0.44}" ry="${hr*0.3}" fill="#fff3e6"/>`}
 ${eyes}
 <path d="M${57} ${hy+hr*0.2} h6 l-3 3.6Z" fill="#f08aa0"/>
 <path d="${mouth}" stroke="${dk}" stroke-width="1.8" fill="none" stroke-linecap="round"/>
 ${k!=='m'?'':`<circle cx="${60-hr*0.62}" cy="${hy+hr*0.3}" r="3.2" fill="#f7a5b0" opacity=".7"/><circle cx="${60+hr*0.62}" cy="${hy+hr*0.3}" r="3.2" fill="#f7a5b0" opacity=".7"/>`}
 </svg>`;
}

