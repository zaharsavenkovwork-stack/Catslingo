mother:['👩','My mother is kind.','Моя мама добрая.'],father:['👨','My father works.','Мой папа работает.'],sister:['👧','Her sister is small.','Её сестра маленькая.'],brother:['👦','My brother plays.','Мой брат играет.'],family:['👪','I love my family.','Я люблю свою семью.'],
water:['💧','I drink water.','Я пью воду.'],bread:['🍞','Bread is fresh.','Хлеб свежий.'],apple:['🍎','The apple is red.','Яблоко красное.'],milk:['🥛','Milk is white.','Молоко белое.'],coffee:['☕','Coffee is hot.','Кофе горячий.'],
