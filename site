    try{localStorage.setItem('eq',JSON.stringify(S))}catch(x){}
    if($('.path'))home();
   }else if((S.t||0)>(c.t||0))cloudSave();
  }catch(x){}});
 })}catch(e){}
}
const RK={c:0,l:1,m:2,t:3,a:4,b:5},HMAX=5,HREG=30*60000,LN=['Котёнок','Любопытный кот','Хвостатый ученик','Кот-полиглот','Профессор Мурр','Мастер слова','Гуру английского','Мудрый кот','Легенда','Король мурлыканья'];
function hearts(){
 if(S.hp>=HMAX){S.hpt=Date.now();return S.hp}
 const n=Math.floor((Date.now()-S.hpt)/HREG);
 if(n>0){S.hp=Math.min(HMAX,S.hp+n);S.hpt+=n*HREG;if(S.hp>=HMAX)S.hpt=Date.now()}
 return S.hp;
}
function loseHeart(){const h=hearts();if(h>=HMAX)S.hpt=Date.now();S.hp=Math.max(0,h-1)}
const nextHeart=()=>Math.max(1,Math.ceil((S.hpt+HREG-Date.now())/60000));
function wordOf(e){if(!e)return null;if(e.t==='c')return e.rev?e.a:e.q;if(e.t==='t'||e.t==='l'||e.t==='a')return e.a;return null}
function homeExtra(){
 const lv=Math.floor(S.xp/100)+1,p=S.xp%100,wk=Object.keys(S.weak).length;
 return `<div class='hero' style='padding:10px 14px;margin-top:-6px'><b style='white-space:nowrap'>🏅 Ур. ${lv} · ${LN[lv-1]||'Мастер'}</b><div class='bar' style='margin-left:10px'><i style='width:${p}%'></i></div></div>`+(wk>=3?`<button class='node cur' style='margin-bottom:16px' onclick='practice()'><div class='ic'>🎯</div><div><b>Повтори слабые слова</b><small>Ждут повторения: ${wk}</small></div></button>`:'');
}
function noHearts(){
 $('#app').innerHTML=`<div class='res pop'>${cat('p','sad')}<h1>Сердечки закончились</h1><div style='color:var(--muted);max-width:300px'>Следующее сердечко через ${nextHeart()} мин. Пока потренируй слабые слова: за тренировку вернётся одно сердечко.</div><div style='margin:16px 0;font-size:24px'>💔💔💔💔💔</div><button class='btn' onclick='practice()'>Тренировать слабые слова</button><button class='btn' style='margin-top:12px;background:var(--card);color:var(--muted);box-shadow:0 5px 0 var(--line)' disabled>📺 Восстановить за рекламу (скоро)</button><button class='btn' style='margin-top:12px;background:var(--card);color:var(--text);box-shadow:0 5px 0 var(--line)' onclick='home()'>На главную</button></div>`;
}
function tut(){
 $('#app').innerHTML=`<div class='lh'><button class='x' onclick='home()'>✕</button><div class='bar'><i style='width:0'></i></div></div><div class='q pop'><h3>Как собирать предложения</h3><div class='hero' style='align-items:flex-start'>${cat('p','think')}<div class='bubble' style='line-height:1.5'>Тебе покажут фразу по-русски, а английские слова будут перемешаны. Нужно выложить их в правильном порядке.</div></div><div class='card' style='text-align:left'><div style='color:var(--muted);font-size:14px'>Пример</div><div class='word' style='font-size:22px;margin:6px 0 10px;text-align:left'>Я студент</div><div class='ans' style='margin:6px 0'><span class='chip'>I</span><span class='chip'>am</span><span class='chip'>a</span><span class='chip'>student</span></div><div style='line-height:1.7;font-size:15px;margin-top:8px'><b>1.</b> Прочитай русскую фразу.<br><b>2.</b> Нажимай на слова внизу по очереди: они встанут в строку сверху.<br><b>3.</b> Ошибся? Нажми на слово в строке, и оно вернётся вниз.<br><b>4.</b> Когда порядок верный, нажми «Проверить».</div></div><button class='btn' onclick='step()'>Понятно, попробую!</button></div>`;
}
function exS(){
 const l=L[G.i];
 if(!l.s.length)return step();
 $('#app').innerHTML=`<div class='lh'><button class='x' onclick='home()'>✕</button><div class='bar'><i style='width:100%'></i></div></div><div class='q pop'><h3>Примеры предложений</h3><div class='hero' style='align-items:flex-start'>${cat('r','happy')}<div class='bubble'>Сначала посмотри, как выглядят готовые предложения. Дальше ты будешь собирать похожие.</div></div>${l.s.map(x=>`<div class='wr'><div><b>${x[1]}</b><small>${x[0]}</small></div><button class='x' data-t='${esc(x[1])}' onclick='say(this.dataset.t)'>🔊</button></div>`).join('')}<button class='btn' style='margin-top:16px' onclick='step()'>К упражнениям</button></div>`;
}
function stepL(e){
 const pr=Math.round(G.k/G.ex.length*100),ty=e.t==='a';
 $('#app').innerHTML=`<div class='lh'><button class='x' onclick='home()' aria-label='Закрыть'>✕</button><div class='bar'><i style='width:${pr}%'></i></div><div class='pill'>❤️ ${hearts()}</div></div><div class='q pop'><h3>${ty?'Послушай и напиши':'Послушай и выбери слово'}</h3><div style='text-align:center;margin:18px 0 22px'><button class='say' style='font-size:22px;padding:18px 28px' id='snd'>🔊 Слушать</button></div>${ty?`<input class='inp' id='inp' autocomplete='off' autocapitalize='off' spellcheck='false' placeholder='Что ты услышал?'><button class='btn' id='chk' style='margin-top:16px'>Проверить</button>`:`<div class='opts'>${e.o.map(o=>`<button class='opt' data-v='${esc(o)}'>${o}</button>`).join('')}</div>`}</div><div id='fbx'></div>`;
 $('#snd').onclick=()=>say(e.a);say(e.a);
 if(ty){const inp=$('#inp');inp.focus();const go=()=>{const ok=inp.value.trim().toLowerCase()===e.a.toLowerCase();inp.disabled=true;$('#chk').style.display='none';fb(ok,e.a,ok?null:'Это слово <b>'+e.a+'</b> ('+e.a.toUpperCase().split('').join('-')+'), по-русски «'+(ALLW.find(x=>x[0]===e.a)||[0,''])[1]+'». Повторим в конце урока.')};$('#chk').onclick=go;inp.onkeydown=ev=>{if(ev.key==='Enter')go()}}
 else document.querySelectorAll('.opt').forEach(b=>b.onclick=()=>pickC(b,e));
}
function practice(){
 let ws=Object.keys(S.weak).sort((a,b)=>S.weak[b]-S.weak[a]).map(en=>ALLW.find(x=>x[0]===en)).filter(Boolean).slice(0,8);
 if(ws.length<4)ws=ws.concat(sh(learned().filter(w=>!ws.includes(w)))).slice(0,6);
 if(!ws.length){
  $('#app').innerHTML=`<div class='res pop'>${cat('p','happy')}<h1>Пока нечего повторять</h1><div style='color:var(--muted)'>Пройди хотя бы один урок.</div><button class='btn' style='margin-top:24px' onclick='home()'>К урокам</button></div>`;return;
 }
 const ex=[];
 ws.forEach((w,k)=>{
  const rev=k%2===1,a=rev?w[0]:w[1],pool=ALLW.map(x=>rev?x[0]:x[1]).filter(x=>x!==a);
  ex.push({t:'c',q:rev?w[1]:w[0],a,o:sh([a,...sh(pool).slice(0,3)]),rev});
  ex.push(k%2===0?{t:'t',q:w[1],a:w[0]}:{t:'l',a:w[0],o:sh([w[0],...sh(ALLW.filter(x=>x[0]!==w[0])).slice(0,3).map(x=>x[0])])});
 });
 G={prac:1,free:1,ex:sh(ex).sort((a,b)=>RK[a.t]-RK[b.t]),k:0,ok:0,sel:[],miss:0,n0:ex.length,bad:new Set()};
 step();
}
function pracResult(){
 const cor=Math.max(0,G.n0-G.miss),xp=cor*5;
 S.xp+=xp;S.hp=Math.min(HMAX,hearts()+1);if(S.hp>=HMAX)S.hpt=Date.now();save();
 const wk=Object.keys(S.weak).length;
 endScr('Тренировка готова!',[['+'+xp,'опыта'],[cor+'/'+G.n0,'верных'],['❤️ '+S.hp,'сердечек']],wk?'Слабых слов осталось: '+wk:'Слабых слов нет, отлично!','practice()');
}
home();
cloudLoad();
</script>
